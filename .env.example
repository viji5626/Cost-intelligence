# ==============================================================================
# HERO Vehicle Cost & Plant OPEX Intelligence Platform
# Environment Configuration (.env.example)
# Note: All configuration is synthetic/demo; zero cloud secrets or dependencies.
# ==============================================================================

# Application Settings
PROJECT_NAME="HERO Vehicle Cost & Plant OPEX Intelligence Platform"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Air-Gap & Telemetry Governance
AIR_GAP_MODE=true
ENABLE_TELEMETRY=false
ALLOW_EXTERNAL_EGRESS=false

# Security & Authentication (Synthetic Demo Defaults)
SECRET_KEY="hero-synthetic-demo-secret-key-change-in-production-airgap"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="hero_admin"
POSTGRES_PASSWORD="hero_secure_password"
POSTGRES_DB="hero_cost_intel"
DATABASE_URL="postgresql+asyncpg://hero_admin:hero_secure_password@localhost:5432/hero_cost_intel"
DATABASE_URL_SYNC="postgresql+psycopg2://hero_admin:hero_secure_password@localhost:5432/hero_cost_intel"

# Hardware Profiling & Local AI Settings
HARDWARE_PROFILE_OVERRIDE="AUTO"
MAX_SAFE_RAM_PERCENT=75
LLAMA_NUM_THREADS=6
DEFAULT_REASONING_MODEL="Qwen2.5-7B-Instruct-Q3_K_M.gguf"
DEFAULT_EMBEDDING_MODEL="Qwen3-Embedding-0.6B"
DEFAULT_RERANKER_MODEL="Qwen3-Reranker-0.6B"
MODEL_REGISTRY_PATH="./models"
